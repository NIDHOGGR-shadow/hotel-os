    {
      "source": "/api/public-catalog",
      "destination": "/api/public-availability?service=catalog"
    },
    {
      "source": "/api/guest-enquiries",
      "destination": "/api/public-availability?service=enquiries"
    },
    {
      "source": "/api/food-checkout",
      "destination": "/api/public-availability?service=food"
    },
    {
      "source": "/api/food-receipt",
      "destination": "/api/public-availability?service=food-receipt"
    },
    {
