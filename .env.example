# HOTEL OS (static HTML + Vercel functions, not a Next.js build).
# This file is a PLACEHOLDER only. Never commit a real Supabase or Paystack secret.
# Set the following directly in Vercel Project > Settings > Environment Variables.
# Use the identical SUPABASE_URL on both the server and staff login.
SUPABASE_URL=https://YOUR_HOTEL_SUPABASE_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_IN_VERCEL
SUPABASE_SECRET_KEY=sb_secret_REPLACE_IN_VERCEL

# Create a real public.properties record after migrations, copy its UUID here.
HOTEL_PROPERTY_ID=YOUR_REAL_PROPERTY_UUID

# Paystack full-payment server integration; test before enabling real charges.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_IN_VERCEL
PAYSTACK_WEBHOOK_SECRET=REPLACE_IN_VERCEL
HOTEL_PAYMENTS_ENABLED=false

# Optional: only after enabling an authenticated cron schedule.
CRON_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET

# HOTEL also supports legacy SUPABASE_ANON_KEY/SUPABASE_SERVICE_ROLE_KEY
# during migration, but new projects should use the publishable/secret keys.
# Database connection string/password is NOT needed for Vercel web APIs.
# The prefix NEXT_PUBLIC_ is NOT required here; HOTEL is currently plain HTML.
